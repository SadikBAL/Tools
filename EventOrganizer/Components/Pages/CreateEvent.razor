@page "/create-event"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject FirestoreService FirestoreService
@inject StorageService StorageService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Config
@implements IAsyncDisposable

<PageTitle>Etkinlik Oluştur</PageTitle>

<div class="create-page">
    <div class="create-card">
        <div class="create-card-header">
            <span class="create-card-title">YENİ ETKİNLİK</span>
        </div>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="create-form">
            <DataAnnotationsValidator />

            <div class="form-row">
                <label>Başlık</label>
                <InputText @bind-Value="_model.Title" placeholder="Etkinlik adı..." />
                <ValidationMessage For="() => _model.Title" />
            </div>

            <div class="form-row">
                <label>Kategori</label>
                <InputSelect @bind-Value="_model.Category" @bind-Value:after="OnCategoryChanged" class="form-select-dark">
                    <option value="music">🎵  Müzik</option>
                    <option value="tech">💻  Teknoloji</option>
                    <option value="art">🎨  Sanat</option>
                    <option value="sport">⚽  Spor</option>
                </InputSelect>
            </div>

            @if (_templates.Count > 0)
            {
                <div class="form-row">
                    <label>Template <span class="form-optional">(opsiyonel)</span></label>
                    <div class="tpl-picker">
                        <button type="button" class="tpl-pick-card @(_selectedTemplateId == "" ? "selected" : "")" @onclick='() => SelectTemplate(null)'>
                            <span class="tpl-pick-name">Yok</span>
                            <span class="tpl-pick-cap">—</span>
                        </button>
                        @foreach (var t in _templates)
                        {
                            var tpl = t;
                            <button type="button" class="tpl-pick-card @(_selectedTemplateId == tpl.Id ? "selected" : "")" @onclick="() => SelectTemplate(tpl)">
                                @if (!string.IsNullOrEmpty(tpl.SvgUrl))
                                {
                                    <img src="@tpl.SvgUrl" class="tpl-pick-svg" alt="" />
                                }
                                <span class="tpl-pick-name">@tpl.Name</span>
                                <span class="tpl-pick-cap">@tpl.Capacity kişi</span>
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="form-row-half">
                <div class="form-row">
                    <label>Tarih &amp; Saat</label>
                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_model.Date" />
                    <ValidationMessage For="() => _model.Date" />
                </div>
                <div class="form-row">
                    <label>Kapasite</label>
                    <InputNumber @bind-Value="_model.Capacity" placeholder="100" disabled="@(_selectedTemplateId != "")" />
                    <ValidationMessage For="() => _model.Capacity" />
                </div>
            </div>

            <div class="form-row">
                <label>Konum</label>
                <input id="locationInput"
                       value="@_model.Location"
                       @oninput='e => _model.Location = e.Value?.ToString() ?? ""'
                       placeholder="Şehir veya mekan ara..."
                       autocomplete="off"
                       class="location-input" />
                <ValidationMessage For="() => _model.Location" />
            </div>

            <div class="form-row">
                <label>Açıklama</label>
                <InputTextArea @bind-Value="_model.Description" placeholder="Etkinlik hakkında kısa bir açıklama..." rows="3" />
                <ValidationMessage For="() => _model.Description" />
            </div>

            <div class="form-row">
                <label>Görsel <span class="form-optional">(opsiyonel)</span></label>
                <InputFile OnChange="OnImageSelected" accept="image/*" id="imageFile" style="display:none" />
                <label for="imageFile" class="file-upload-btn">
                    @if (_imageFileName != null)
                    {
                        <span>📎 @_imageFileName</span>
                    }
                    else
                    {
                        <span>📁 Görsel seç...</span>
                    }
                </label>
                @if (_imagePreview != null)
                {
                    <div class="image-preview-wrap">
                        <img src="@_imagePreview" class="image-preview-img" alt="Önizleme" />
                        <button type="button" class="image-clear-btn" @onclick="ClearImage">✕</button>
                    </div>
                }
            </div>

            <div class="form-row form-row-toggle">
                <label>Herkese Açık</label>
                <InputCheckbox @bind-Value="_model.IsPublic" class="form-toggle" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="form-error">@_error</div>
            }

            <button type="submit" class="form-submit" disabled="@_submitting">
                @(_uploading ? "Görsel yükleniyor..." : _submitting ? "Oluşturuluyor..." : "Etkinlik Oluştur")
            </button>
        </EditForm>
    </div>
</div>

@if (_showCropper)
{
    <div class="crop-overlay">
        <div class="crop-modal">
            <div class="crop-header">
                <span class="crop-title">GÖRSELİ KIRP</span>
                <span class="crop-hint">Sürükle · Zoom</span>
            </div>
            <div class="crop-container">
                <img id="cropperImage" alt="" style="max-width:100%;display:block;" />
            </div>
            <div class="crop-actions">
                <button type="button" class="crop-btn-cancel" @onclick="CancelCrop">İptal</button>
                <button type="button" class="crop-btn-apply" @onclick="ConfirmCrop">Uygula</button>
            </div>
        </div>
    </div>
}

@code {
    private EventFormModel      _model      = new();
    private bool                _submitting;
    private bool                _uploading;
    private string              _error      = "";
    private DotNetObjectReference<CreateEvent>? _dotNetRef;

    private List<EventTemplate> _templates          = [];
    private string              _selectedTemplateId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private byte[]? _imageBytes;
    private string? _imageContentType;
    private string? _imageFileName;
    private string? _imagePreview;
    private bool    _showCropper;
    private string? _cropperSrc;
    private int     _cropX, _cropY, _cropW, _cropH;

    private async Task LoadTemplates()
    {
        try { _templates = await FirestoreService.GetTemplatesByCategoryAsync(_model.Category); }
        catch { _templates = []; }
    }

    private async Task OnCategoryChanged()
    {
        _selectedTemplateId = "";
        await LoadTemplates();
    }

    private void SelectTemplate(EventTemplate? tpl)
    {
        if (tpl == null)
        {
            _selectedTemplateId = "";
            _model.Capacity     = 0;
        }
        else
        {
            _selectedTemplateId = tpl.Id;
            _model.Capacity     = tpl.Capacity;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var apiKey = Config["GoogleMaps:ApiKey"];
        if (string.IsNullOrEmpty(apiKey)) return;
        try
        {
            await JS.InvokeVoidAsync("loadGoogleMapsScript", apiKey);
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initMapsAutocomplete", "locationInput", _dotNetRef);
        }
        catch { }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        _error = "";
        try
        {
            var file       = e.File;
            _imageFileName = file.Name;

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms     = new MemoryStream();
            await stream.CopyToAsync(ms);
            _imageBytes       = ms.ToArray();
            _imageContentType = file.ContentType;

            _cropperSrc  = $"data:{file.ContentType};base64,{Convert.ToBase64String(_imageBytes)}";
            _showCropper = true;
            StateHasChanged();

            await Task.Delay(200);
            await JS.InvokeVoidAsync("initCropper", _cropperSrc);
        }
        catch
        {
            _error = "Görsel okunamadı. Lütfen 10 MB altında bir resim seçin.";
            ClearImage();
        }
    }

    private async Task ConfirmCrop()
    {
        try
        {
            var crop = await JS.InvokeAsync<CropData?>("getCropData");
            if (crop != null)
            {
                _cropX = crop.X; _cropY = crop.Y;
                _cropW = crop.Width; _cropH = crop.Height;
            }

            var preview = await JS.InvokeAsync<string?>("getCroppedPreview");
            if (!string.IsNullOrEmpty(preview))
                _imagePreview = preview;
        }
        catch { /* preview başarısız olsa da devam et */ }
        finally
        {
            _showCropper = false;
            await JS.InvokeVoidAsync("destroyCropper");
            StateHasChanged();
        }
    }

    private async Task CancelCrop()
    {
        _showCropper = false;
        await JS.InvokeVoidAsync("destroyCropper");
        await JS.InvokeVoidAsync("resetFileInput", "imageFile");
        ClearImage();
    }

    private void ClearImage()
    {
        _imageBytes       = null;
        _imageContentType = null;
        _imageFileName    = null;
        _imagePreview     = null;
        _cropperSrc       = null;
    }

    [JSInvokable]
    public void OnPlaceSelected(string place)
    {
        _model.Location = place;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        await Task.CompletedTask;
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error      = "";

        try
        {
            if (_imageBytes != null && _imageFileName != null && _imageContentType != null)
            {
                _uploading = true;
                StateHasChanged();
                using var ms = new MemoryStream(_imageBytes);
                _model.ImageUrl = await StorageService.UploadImageAsync(ms, _imageFileName, _imageContentType,
                    _cropX, _cropY, _cropW, _cropH);
                _uploading = false;
            }

            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            var creatorId      = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
            var creatorName    = user.Identity?.Name ?? "";
            var creatorPicture = user.FindFirst("picture")?.Value ?? "";

            var evt = new EventItem
            {
                Title           = _model.Title,
                Category        = _model.Category,
                Date            = DateTime.SpecifyKind(_model.Date, DateTimeKind.Utc),
                Location        = _model.Location,
                Capacity        = _model.Capacity,
                Description     = _model.Description,
                ImageUrl        = _model.ImageUrl,
                CreatedByUserId = creatorId,
                CreatedByName   = creatorName,
                IsPublic        = _model.IsPublic,
                TemplateId      = _selectedTemplateId,
                Participants    = [new Participant { UserId = creatorId, Name = creatorName, PictureUrl = creatorPicture, SlotIndex = 0 }],
                ParticipantIds  = [creatorId],
            };

            await FirestoreService.CreateEventAsync(evt);
            Navigation.NavigateTo("/my-events");
        }
        catch (Exception ex)
        {
            _error      = $"Hata: {ex.Message}";
            _uploading  = false;
            _submitting = false;
        }
    }
}

<style>
/* ── Image preview ── */
.image-preview-wrap {
    position: relative;
    margin-top: 8px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
}

.image-preview-img {
    width: 100%;
    max-height: 180px;
    object-fit: cover;
    display: block;
}

.image-clear-btn {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: rgba(0,0,0,0.65);
    color: rgba(255,255,255,0.8);
    font-size: 11px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
}

.image-clear-btn:hover {
    background: rgba(239,68,68,0.75);
    color: #fff;
}

/* ── Crop modal ── */
.crop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.crop-modal {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(10,10,25,0.98);
}

.crop-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.crop-title {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 3px;
    color: rgba(255,255,255,0.35);
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
}

.crop-hint {
    font-size: 10px;
    color: rgba(255,255,255,0.25);
    font-family: 'JetBrains Mono', monospace;
}

.crop-container {
    width: 100%;
    height: 380px;
    background: #000;
    overflow: hidden;
}

.crop-actions {
    display: flex;
    gap: 0.75rem;
    padding: 12px 16px;
    border-top: 1px solid rgba(255,255,255,0.08);
}

.crop-btn-cancel {
    flex: 1;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.12);
    background: transparent;
    color: rgba(255,255,255,0.55);
    font-size: 12px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    cursor: pointer;
    transition: all 0.2s;
}

.crop-btn-cancel:hover {
    border-color: rgba(255,255,255,0.3);
    color: rgba(255,255,255,0.85);
}

.crop-btn-apply {
    flex: 2;
    padding: 10px;
    border-radius: 10px;
    border: none;
    background: linear-gradient(135deg, #7c3aed, #2563eb);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    cursor: pointer;
    transition: opacity 0.2s;
}

.crop-btn-apply:hover { opacity: 0.88; }

/* Google Maps autocomplete dropdown - dark tema */
.pac-container {
    background: rgba(12, 12, 28, 0.98) !important;
    border: 1px solid rgba(255,255,255,0.12) !important;
    border-radius: 12px !important;
    box-shadow: 0 12px 36px rgba(0,0,0,0.6) !important;
    font-family: 'JetBrains Mono', monospace !important;
    overflow: hidden;
    margin-top: 4px;
    z-index: 99999 !important;
}
.pac-item {
    padding: 8px 14px !important;
    color: rgba(255,255,255,0.75) !important;
    border-top: 1px solid rgba(255,255,255,0.05) !important;
    cursor: pointer;
    font-size: 11px !important;
    background: transparent !important;
}
.pac-item:hover, .pac-item-selected {
    background: rgba(124, 58, 237, 0.15) !important;
}
.pac-item-query {
    color: #fff !important;
    font-size: 12px !important;
}
.pac-matched { color: #a78bfa !important; }
.pac-icon { display: none !important; }
.pac-logo::after { display: none !important; }
</style>
