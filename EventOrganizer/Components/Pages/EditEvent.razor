@page "/edit-event/{Id}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject FirestoreService FirestoreService
@inject StorageService StorageService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Config
@implements IAsyncDisposable

<PageTitle>Etkinliği Düzenle</PageTitle>

<div class="create-page">
    <div class="create-card">
        <div class="create-card-header">
            <span class="create-card-title">ETKİNLİĞİ DÜZENLE</span>
        </div>

        @if (_loading)
        {
            <div class="cards-loading">Yükleniyor...</div>
        }
        else if (_notFound)
        {
            <div class="cards-empty">Etkinlik bulunamadı.</div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="create-form">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label>Başlık</label>
                    <InputText @bind-Value="_model.Title" placeholder="Etkinlik adı..." />
                    <ValidationMessage For="() => _model.Title" />
                </div>

                <div class="form-row">
                    <label>Kategori</label>
                    <InputSelect @bind-Value="_model.Category" class="form-select-dark">
                        <option value="music">🎵  Müzik</option>
                        <option value="tech">💻  Teknoloji</option>
                        <option value="art">🎨  Sanat</option>
                        <option value="sport">⚽  Spor</option>
                    </InputSelect>
                </div>

                <div class="form-row-half">
                    <div class="form-row">
                        <label>Tarih &amp; Saat</label>
                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_model.Date" />
                        <ValidationMessage For="() => _model.Date" />
                    </div>
                    <div class="form-row">
                        <label>Kapasite</label>
                        <InputNumber @bind-Value="_model.Capacity" placeholder="100" />
                        <ValidationMessage For="() => _model.Capacity" />
                    </div>
                </div>

                <div class="form-row">
                    <label>Konum</label>
                    <input id="locationInput"
                           value="@_model.Location"
                           @oninput='e => _model.Location = e.Value?.ToString() ?? ""'
                           placeholder="Şehir veya mekan ara..."
                           autocomplete="off"
                           class="location-input" />
                    <ValidationMessage For="() => _model.Location" />
                </div>

                <div class="form-row">
                    <label>Açıklama</label>
                    <InputTextArea @bind-Value="_model.Description" placeholder="Etkinlik hakkında kısa bir açıklama..." rows="3" />
                    <ValidationMessage For="() => _model.Description" />
                </div>

                <div class="form-row">
                    <label>Görsel <span class="form-optional">(opsiyonel)</span></label>
                    <InputFile OnChange="OnImageSelected" accept="image/*" id="imageFile" style="display:none" />
                    <label for="imageFile" class="file-upload-btn">
                        @if (_imageFileName != null)
                        {
                            <span>📎 @_imageFileName</span>
                        }
                        else if (!string.IsNullOrEmpty(_model.ImageUrl))
                        {
                            <span>📎 Mevcut görsel (değiştirmek için seç)</span>
                        }
                        else
                        {
                            <span>📁 Görsel seç...</span>
                        }
                    </label>
                    @if (_imagePreview != null)
                    {
                        <div class="image-preview-wrap">
                            <img src="@_imagePreview" class="image-preview-img" alt="Önizleme" />
                            <button type="button" class="image-clear-btn" @onclick="ClearImage">✕</button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_model.ImageUrl))
                    {
                        <div class="image-preview-wrap">
                            <img src="@_model.ImageUrl" class="image-preview-img" alt="Mevcut görsel" />
                            <button type="button" class="image-clear-btn" @onclick="RemoveCurrentImage">✕</button>
                        </div>
                    }
                </div>

                <div class="form-row form-row-toggle">
                    <label>Herkese Açık</label>
                    <InputCheckbox @bind-Value="_model.IsPublic" class="form-toggle" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="form-error">@_error</div>
                }

                <div class="edit-actions">
                    <button type="button" class="form-cancel" @onclick="Cancel">İptal</button>
                    <button type="submit" class="form-submit" disabled="@_submitting">
                        @(_uploading ? "Görsel yükleniyor..." : _submitting ? "Kaydediliyor..." : "Kaydet")
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private EventFormModel _model      = new();
    private bool           _loading    = true;
    private bool           _notFound   = false;
    private bool           _submitting = false;
    private bool           _uploading  = false;
    private string         _error      = "";
    private DotNetObjectReference<EditEvent>? _dotNetRef;

    private byte[]? _imageBytes;
    private string? _imageContentType;
    private string? _imageFileName;
    private string? _imagePreview;
    private bool    _imageClearedByUser = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        var evt = await FirestoreService.GetEventByIdAsync(Id);
        if (evt == null || evt.CreatedByUserId != userId)
        {
            _notFound = true;
            _loading  = false;
            return;
        }

        _model = new EventFormModel
        {
            Title       = evt.Title,
            Category    = evt.Category,
            Date        = evt.Date.ToLocalTime(),
            Location    = evt.Location,
            Capacity    = evt.Capacity,
            Description = evt.Description,
            ImageUrl    = evt.ImageUrl,
            IsPublic    = evt.IsPublic,
        };
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _notFound) return;
        var apiKey = Config["GoogleMaps:ApiKey"];
        if (string.IsNullOrEmpty(apiKey)) return;
        try
        {
            await JS.InvokeVoidAsync("loadGoogleMapsScript", apiKey);
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initMapsAutocomplete", "locationInput", _dotNetRef);
        }
        catch { }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        _error = "";
        _imageClearedByUser = false;
        try
        {
            var file          = e.File;
            _imageFileName    = file.Name;
            _imageContentType = file.ContentType;

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms     = new MemoryStream();
            await stream.CopyToAsync(ms);
            _imageBytes = ms.ToArray();

            var thumb = await file.RequestImageFileAsync("image/jpeg", 480, 320);
            using var ts  = thumb.OpenReadStream(maxAllowedSize: 1024 * 1024);
            using var tms = new MemoryStream();
            await ts.CopyToAsync(tms);
            _imagePreview = $"data:image/jpeg;base64,{Convert.ToBase64String(tms.ToArray())}";
        }
        catch
        {
            _error = "Görsel okunamadı. Lütfen 5 MB altında bir resim seçin.";
            ClearImage();
        }
    }

    private void ClearImage()
    {
        _imageBytes       = null;
        _imageContentType = null;
        _imageFileName    = null;
        _imagePreview     = null;
    }

    private void Cancel() => Navigation.NavigateTo("/my-events");

    private void RemoveCurrentImage()
    {
        _model.ImageUrl     = "";
        _imageClearedByUser = true;
        ClearImage();
    }

    [JSInvokable]
    public void OnPlaceSelected(string place)
    {
        _model.Location = place;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        await Task.CompletedTask;
    }

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error      = "";

        try
        {
            string? imageUrl = _imageClearedByUser ? "" : _model.ImageUrl;

            if (_imageBytes != null && _imageFileName != null && _imageContentType != null)
            {
                _uploading = true;
                StateHasChanged();
                using var ms = new MemoryStream(_imageBytes);
                imageUrl = await StorageService.UploadImageAsync(ms, _imageFileName, _imageContentType);
                _uploading = false;
            }

            var evt = await FirestoreService.GetEventByIdAsync(Id);
            if (evt == null) { _error = "Etkinlik bulunamadı."; _submitting = false; return; }

            evt.Title       = _model.Title;
            evt.Category    = _model.Category;
            evt.Date        = DateTime.SpecifyKind(_model.Date, DateTimeKind.Utc);
            evt.Location    = _model.Location;
            evt.Capacity    = _model.Capacity;
            evt.Description = _model.Description;
            evt.ImageUrl    = imageUrl ?? "";
            evt.IsPublic    = _model.IsPublic;

            await FirestoreService.UpdateEventAsync(evt);
            Navigation.NavigateTo("/my-events");
        }
        catch (Exception ex)
        {
            _error      = $"Hata: {ex.Message}";
            _uploading  = false;
            _submitting = false;
        }
    }
}

<style>
.create-page {
    display: flex;
    justify-content: center;
    padding: 2.5rem 1rem;
}

.create-card {
    width: 100%;
    max-width: 560px;
    background: rgba(10, 10, 25, 0.82);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px;
    padding: 2rem 2.2rem;
    backdrop-filter: blur(14px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.5);
}

.create-card-header {
    margin-bottom: 1.8rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 1rem;
}

.create-card-title {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 3px;
    color: rgba(255,255,255,0.35);
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
}

.create-form { display: flex; flex-direction: column; gap: 1.1rem; }

.form-row { display: flex; flex-direction: column; gap: 5px; }

.form-row label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    font-family: 'JetBrains Mono', monospace;
}

.form-optional { font-weight: 400; opacity: 0.6; text-transform: none; letter-spacing: 0; }

.create-form input,
.create-form textarea,
.form-select-dark {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 9px 13px;
    color: #f1f5f9;
    font-size: 13px;
    font-family: 'JetBrains Mono', monospace;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    width: 100%;
    box-sizing: border-box;
    color-scheme: dark;
    -webkit-text-fill-color: #f1f5f9;
}

.create-form input:focus,
.create-form textarea:focus,
.form-select-dark:focus {
    border-color: rgba(124, 58, 237, 0.7);
    background: rgba(124, 58, 237, 0.06);
}

.create-form input:-webkit-autofill,
.create-form input:-webkit-autofill:hover,
.create-form input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0px 1000px #0e0e1f inset;
    -webkit-text-fill-color: #f1f5f9;
    caret-color: #f1f5f9;
}

.form-select-dark option { background: #1a1a2e; }

.create-form textarea { resize: vertical; min-height: 72px; }

.form-row-half { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

.form-row-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.form-toggle {
    width: 18px;
    height: 18px;
    accent-color: #7c3aed;
    cursor: pointer;
}

.form-error {
    background: rgba(239,68,68,0.1);
    border: 1px solid rgba(239,68,68,0.3);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    color: #fca5a5;
    font-family: 'JetBrains Mono', monospace;
}

.create-form .validation-message {
    font-size: 10px;
    color: #fca5a5;
    font-family: 'JetBrains Mono', monospace;
    margin-top: 2px;
}

.form-submit {
    margin-top: 0.5rem;
    padding: 11px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #7c3aed, #2563eb);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
}

.form-submit:hover:not(:disabled) { opacity: 0.88; transform: translateY(-1px); }
.form-submit:disabled { opacity: 0.5; cursor: default; }

.file-upload-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    background: rgba(255,255,255,0.05);
    border: 1px dashed rgba(255,255,255,0.2);
    border-radius: 10px;
    color: rgba(255,255,255,0.55);
    font-size: 12px;
    font-family: 'JetBrains Mono', monospace;
    cursor: pointer;
    transition: all 0.2s;
    box-sizing: border-box;
    width: 100%;
}

.file-upload-btn:hover {
    border-color: rgba(124,58,237,0.6);
    background: rgba(124,58,237,0.07);
    color: rgba(255,255,255,0.9);
}

.image-preview-wrap {
    position: relative;
    margin-top: 8px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
}

.image-preview-img {
    width: 100%;
    max-height: 180px;
    object-fit: cover;
    display: block;
}

.image-clear-btn {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: rgba(0,0,0,0.65);
    color: rgba(255,255,255,0.8);
    font-size: 11px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
}

.image-clear-btn:hover {
    background: rgba(239,68,68,0.75);
    color: #fff;
}

.cards-loading, .cards-empty {
    width: 100%;
    text-align: center;
    padding: 4rem 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: rgba(255,255,255,0.3);
    letter-spacing: 1px;
}

.pac-container {
    background: rgba(12, 12, 28, 0.98) !important;
    border: 1px solid rgba(255,255,255,0.12) !important;
    border-radius: 12px !important;
    box-shadow: 0 12px 36px rgba(0,0,0,0.6) !important;
    font-family: 'JetBrains Mono', monospace !important;
    overflow: hidden;
    margin-top: 4px;
    z-index: 99999 !important;
}
.pac-item {
    padding: 8px 14px !important;
    color: rgba(255,255,255,0.75) !important;
    border-top: 1px solid rgba(255,255,255,0.05) !important;
    cursor: pointer;
    font-size: 11px !important;
    background: transparent !important;
}
.pac-item:hover, .pac-item-selected {
    background: rgba(124, 58, 237, 0.15) !important;
}
.pac-item-query {
    color: #fff !important;
    font-size: 12px !important;
}
.pac-matched { color: #a78bfa !important; }
.pac-icon { display: none !important; }
.pac-logo::after { display: none !important; }

.edit-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
}

.form-cancel {
    flex: 1;
    padding: 11px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.12);
    background: transparent;
    color: rgba(255,255,255,0.55);
    font-size: 13px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
}

.form-cancel:hover {
    border-color: rgba(255,255,255,0.3);
    color: rgba(255,255,255,0.85);
}

.edit-actions .form-submit { flex: 2; margin-top: 0; }
</style>
