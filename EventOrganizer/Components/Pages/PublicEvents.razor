@page "/"
@page "/public-events"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject FirestoreService FirestoreService
@inject StorageService StorageService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Etkinlikler</PageTitle>

@if (_loading)
{
    <div class="cards-loading-overlay">
        <div class="lo-scanner">
            <div class="lo-ring lo-ring-1"></div>
            <div class="lo-ring lo-ring-2"></div>
            <div class="lo-ring lo-ring-3"></div>
            <div class="lo-core"></div>
        </div>
        <div class="lo-texts">
            <div class="lo-label">Etkinlikler</div>
            <div class="lo-sublabel">Yükleniyor</div>
        </div>
        <div class="lo-dots"><span></span><span></span><span></span></div>
    </div>
}
else
{
    <div class="filters-row">
        <div class="category-filter" id="categoryFilter"></div>
        <div class="date-timeline"   id="dateTimeline"></div>
    </div>

    <div class="cards-grid" id="cardsGrid">
        @if (_error != null)
        {
            <div class="cards-empty">⚠ Bağlantı hatası: @_error</div>
        }
        else if (_events.Count == 0)
        {
            <div class="cards-empty">Henüz etkinlik yok.</div>
        }
        else
        {
            @foreach (var (evt, i) in _events.Select((e, i) => (e, i + 1)))
            {
                <EventCard Event="evt" Index="i" SetName="EventOrganizer"
                           CurrentUserId="@_currentUserId"
                           CurrentUserName="@_currentUserName"
                           CurrentUserPicture="@_currentUserPicture"
                           OnDelete="DeleteEvent"
                           OnJoin="HandleJoinNotify"
                           OnLeave="LeaveEvent" />
            }
        }
    </div>
}

@code {
    private List<EventItem> _events       = [];
    private bool            _loading      = true;
    private string?         _error;
    private string          _currentUserId      = "";
    private string          _currentUserName    = "";
    private string          _currentUserPicture = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _currentUserId      = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
                _currentUserName    = user.Identity.Name ?? "";
                _currentUserPicture = user.FindFirst("picture")?.Value ?? "";
            }

            _events = await FirestoreService.GetPublicEventsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading)
        {
            await JS.InvokeVoidAsync("initCategoryFilter");
            await JS.InvokeVoidAsync("initDateTimeline");
        }
    }

    // EventCard join'i kendi içinde Firestore'a yazar; bu callback yalnızca
    // parent'ın state'ini (Blazor filter, re-render) senkronize eder.
    private Task HandleJoinNotify(string eventId) => Task.CompletedTask;

    private async Task LeaveEvent(string eventId)
    {
        await FirestoreService.LeaveEventAsync(eventId, _currentUserId);

        var evt = _events.FirstOrDefault(e => e.Id == eventId);
        if (evt != null)
        {
            evt.Participants.RemoveAll(p => p.UserId == _currentUserId);
            evt.ParticipantIds.Remove(_currentUserId);
        }
    }

    private async Task DeleteEvent(string id)
    {
        var imageUrl = _events.FirstOrDefault(e => e.Id == id)?.ImageUrl;
        await FirestoreService.DeleteEventAsync(id);
        await StorageService.DeleteImageAsync(imageUrl);
        _events.RemoveAll(e => e.Id == id);
    }
}
