@page "/public-events"

<PageTitle>Herkese Açık Etkinlikler</PageTitle>

<h3 class="text-center mt-3 mb-1">Etkinlikler</h3>
<p class="text-center text-muted mb-0" style="font-size:0.85rem">Kartların üzerine gel ✨</p>

<div class="cards-grid">

    @* Test Kart 1: Müzik Etkinliği *@
    <div class="event-card music">
        <div class="card-translater">
            <div class="card-rotator">
                <div class="card-front">

                    <div class="card-title">Rock Gecesi 2025</div>
                    <div class="card-hp"><span>120</span> HP</div>

                    <div class="card-image">
                        <img src="https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=400&h=300&fit=crop"
                             alt="Rock Gecesi" />
                    </div>

                    <div class="card-type music">Müzik</div>

                    <div class="card-info">
                        <div class="card-info-row">
                            <span class="icon">📅</span>
                            <span>15 Mart 2025, Cumartesi</span>
                        </div>
                        <div class="card-info-row">
                            <span class="icon">📍</span>
                            <span>Kadıköy Sahne, İstanbul</span>
                        </div>
                        <div class="card-info-row">
                            <span class="icon">👥</span>
                            <span>Kapasite: 500 kişi</span>
                        </div>
                    </div>

                    <div class="card-divider"></div>
                    <div class="card-desc">En iyi rock gruplarıyla unutulmaz bir gece. Biletler sınırlı sayıda!</div>

                    <div class="card-footer">
                        <span class="card-set">EventOrganizer</span>
                        <span class="card-number">#001</span>
                    </div>

                    <div class="card-shine"></div>
                    <div class="card-glare"></div>
                </div>
            </div>
        </div>
    </div>

    @* Test Kart 2: Teknoloji Etkinliği *@
    <div class="event-card tech">
        <div class="card-translater">
            <div class="card-rotator">
                <div class="card-front">

                    <div class="card-title">DevFest İstanbul</div>
                    <div class="card-hp"><span>200</span> HP</div>

                    <div class="card-image">
                        <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=400&h=300&fit=crop"
                             alt="DevFest İstanbul" />
                    </div>

                    <div class="card-type tech">Teknoloji</div>

                    <div class="card-info">
                        <div class="card-info-row">
                            <span class="icon">📅</span>
                            <span>20 Nisan 2025, Pazar</span>
                        </div>
                        <div class="card-info-row">
                            <span class="icon">📍</span>
                            <span>Sabancı Center, İstanbul</span>
                        </div>
                        <div class="card-info-row">
                            <span class="icon">👥</span>
                            <span>Kapasite: 1000 kişi</span>
                        </div>
                    </div>

                    <div class="card-divider"></div>
                    <div class="card-desc">Yazılım, yapay zeka ve teknoloji festivali. Dünyaca ünlü konuşmacılar.</div>

                    <div class="card-footer">
                        <span class="card-set">EventOrganizer</span>
                        <span class="card-number">#002</span>
                    </div>

                    <div class="card-shine"></div>
                    <div class="card-glare"></div>
                </div>
            </div>
        </div>
    </div>

</div>

