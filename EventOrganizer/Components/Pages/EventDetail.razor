@page "/event/{Id}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject FirestoreService FirestoreService
@inject StorageService StorageService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_event?.Title ?? "Etkinlik")</PageTitle>

@if (_loading)
{
    <div class="cards-loading-overlay">
        <div class="lo-scanner">
            <div class="lo-ring lo-ring-1"></div>
            <div class="lo-ring lo-ring-2"></div>
            <div class="lo-ring lo-ring-3"></div>
            <div class="lo-core"></div>
        </div>
        <div class="lo-texts">
            <div class="lo-label">Etkinlik</div>
            <div class="lo-sublabel">Yükleniyor</div>
        </div>
        <div class="lo-dots"><span></span><span></span><span></span></div>
    </div>
}
else if (_event == null)
{
    <div class="cards-empty">Etkinlik bulunamadı.</div>
}
else
{
    <div class="cards-grid" id="cardsGrid">
        <EventCard Event="_event" Index="1" SetName="EventOrganizer"
                   CurrentUserId="@_currentUserId"
                   OnDelete="DeleteEvent"
                   OnJoin="JoinEvent"
                   OnLeave="LeaveEvent" />
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private EventItem? _event;
    private bool       _loading       = true;
    private bool       _previewOpened = false;
    private string     _currentUserId      = "";
    private string     _currentUserName    = "";
    private string     _currentUserPicture = "";

    private bool IsOwner => !string.IsNullOrEmpty(_currentUserId) && _event?.CreatedByUserId == _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _currentUserId      = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
                _currentUserName    = user.Identity.Name ?? "";
                _currentUserPicture = user.FindFirst("picture")?.Value ?? "";
            }

            _event = await FirestoreService.GetEventByIdAsync(Id);
        }
        catch { /* etkinlik bulunamazsa null kalır */ }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && _event != null && !_previewOpened)
        {
            _previewOpened = true;
            await JS.InvokeVoidAsync("openEventPreview");
        }
    }

    private async Task JoinEvent(string eventId)
    {
        var participant = new Participant
        {
            UserId     = _currentUserId,
            Name       = _currentUserName,
            PictureUrl = _currentUserPicture,
        };
        await FirestoreService.JoinEventAsync(eventId, participant);

        if (_event != null)
        {
            _event.Participants.Add(participant);
            _event.ParticipantIds.Add(_currentUserId);
        }
    }

    private async Task LeaveEvent(string eventId)
    {
        await FirestoreService.LeaveEventAsync(eventId, _currentUserId);

        if (_event != null)
        {
            _event.Participants.RemoveAll(p => p.UserId == _currentUserId);
            _event.ParticipantIds.Remove(_currentUserId);
        }
    }

    private async Task DeleteEvent(string id)
    {
        var imageUrl = _event?.ImageUrl;
        await FirestoreService.DeleteEventAsync(id);
        await StorageService.DeleteImageAsync(imageUrl);
        Nav.NavigateTo("/my-events");
    }
}
