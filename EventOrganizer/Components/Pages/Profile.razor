@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Profilim</PageTitle>

<div class="profile-page">
    <div class="event-card profile">
        <div class="card-translater">
            <div class="card-rotator">
                <div class="card-front">

                    <div class="card-title">Profil Kartı</div>

                    <div class="card-image avatar-area">
                        <div class="avatar-circle">
                            <span>@initial</span>
                        </div>
                    </div>

                    <div class="card-type profile-type">Üye</div>

                    <div class="card-info">
                        <div class="card-info-row">
                            <span class="icon">👤</span>
                            <span>@displayName</span>
                        </div>
                        <div class="card-info-row">
                            <span class="icon">✉️</span>
                            <span>@email</span>
                        </div>
                        <div class="card-info-row">
                            <span class="icon">🎂</span>
                            <span>1 Ocak 1990</span>
                        </div>
                    </div>

                    <div class="card-divider"></div>

                    <div class="card-footer">
                        <span class="card-set">EventOrganizer</span>
                        <a href="/logout" class="logout-card-btn" title="Çıkış Yap">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                            </svg>
                            Çıkış Yap
                        </a>
                    </div>

                    <div class="card-shine"></div>
                    <div class="card-glare"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string displayName = "";
    private string initial = "?";
    private string email = "";

    protected override void OnInitialized()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        displayName = user?.Identity?.Name ?? "?";
        initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "?";
        email = user?.FindFirst(ClaimTypes.Email)?.Value ?? "";
    }
}

<style>
    .profile-page {
        display: flex;
        justify-content: center;
        padding: 3rem 1rem;
    }

    .event-card.profile .card-front {
        background: linear-gradient(160deg, #0a1628 0%, #1a2744 40%, #0d1f3c 100%);
        border-color: #4a9eff;
        box-shadow: inset 0 0 0 2px rgba(74, 158, 255, 0.2);
    }

    .card-type.profile-type {
        background: #4a9eff;
        color: #fff;
    }

    .avatar-area {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border-color: rgba(74, 158, 255, 0.4);
    }

    .avatar-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a3a6e, #4a9eff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        font-weight: 900;
        color: white;
        text-shadow: 0 2px 8px rgba(0,0,0,0.5);
        box-shadow: 0 0 20px rgba(74, 158, 255, 0.4);
    }

    .logout-card-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 8px;
        color: rgba(255, 100, 100, 0.8);
        text-decoration: none;
        padding: 3px 6px;
        border-radius: 4px;
        border: 1px solid rgba(255, 100, 100, 0.3);
        transition: all 0.2s;
        font-family: 'Gill Sans MT', 'Gill Sans', sans-serif;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .logout-card-btn:hover {
        color: #ff4444;
        border-color: rgba(255, 68, 68, 0.6);
        background: rgba(255, 68, 68, 0.1);
    }
</style>
