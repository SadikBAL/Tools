@page "/my-events"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject FirestoreService FirestoreService
@inject StorageService StorageService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Etkinliklerim</PageTitle>

@if (_loading)
{
    <div class="cards-loading-overlay">
        <div class="lo-scanner">
            <div class="lo-ring lo-ring-1"></div>
            <div class="lo-ring lo-ring-2"></div>
            <div class="lo-ring lo-ring-3"></div>
            <div class="lo-core"></div>
        </div>
        <div class="lo-texts">
            <div class="lo-label">Etkinliklerim</div>
            <div class="lo-sublabel">Yükleniyor</div>
        </div>
        <div class="lo-dots"><span></span><span></span><span></span></div>
    </div>
}
else
{
    <div class="filters-row">
        <div class="category-filter" id="categoryFilter"></div>
        <div class="date-timeline"   id="dateTimeline"></div>
    </div>

    <div class="cards-grid" id="cardsGrid">
        @if (_error != null)
        {
            <div class="cards-empty">⚠ Bağlantı hatası: @_error</div>
        }
        else if (_events.Count == 0)
        {
            <div class="cards-empty">Henüz etkinlik oluşturmadınız.</div>
        }
        else
        {
            @foreach (var (evt, i) in _events.Select((e, i) => (e, i + 1)))
            {
                <EventCard Event="evt" Index="i" SetName="Etkinliklerim"
                           CurrentUserId="@_currentUserId"
                           OnDelete="DeleteEvent"
                           OnLeave="LeaveEvent" />
            }
        }
    </div>
}

@code {
    private List<EventItem> _events      = [];
    private bool            _loading     = true;
    private string?         _error;
    private string          _currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
            _events = await FirestoreService.GetUserRelatedEventsAsync(_currentUserId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading)
        {
            await JS.InvokeVoidAsync("initCategoryFilter");
            await JS.InvokeVoidAsync("initDateTimeline");
        }
    }

    private async Task LeaveEvent(string eventId)
    {
        await FirestoreService.LeaveEventAsync(eventId, _currentUserId);
        _events.RemoveAll(e => e.Id == eventId);
    }

    private async Task DeleteEvent(string id)
    {
        var imageUrl = _events.FirstOrDefault(e => e.Id == id)?.ImageUrl;
        await FirestoreService.DeleteEventAsync(id);
        await StorageService.DeleteImageAsync(imageUrl);
        _events.RemoveAll(e => e.Id == id);
    }
}
