@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">EventOrganizer</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="public-events">
                <span class="bi bi-calendar-event-nav-menu" aria-hidden="true"></span> Etkinlikler
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="my-events">
                        <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Etkinliklerim
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="create-event">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Etkinlik Oluştur
                    </NavLink>
                </div>
                <hr class="text-white mx-3 mt-3 mb-1" />
                <div class="nav-item px-3">
                    <span class="nav-link text-white-50 small">
                        👤 @context.User.Identity?.Name
                    </span>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/logout">Çıkış Yap</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <hr class="text-white mx-3 mt-3 mb-1" />
                <div class="nav-item px-3">
                    <a class="nav-link" href="/login">Google ile Giriş Yap</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>
