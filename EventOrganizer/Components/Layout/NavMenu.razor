@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">EventOrganizer</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="public-events">
                <span class="bi bi-calendar-event-nav-menu" aria-hidden="true"></span> Etkinlikler
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="my-events">
                        <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Etkinliklerim
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="create-event">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Etkinlik Oluştur
                    </NavLink>
                </div>
                <hr class="text-white mx-3 mt-3 mb-1" />
                <div class="nav-item px-3 d-flex align-items-center gap-2">
                    <a class="nav-link text-white-50 small flex-grow-1 py-1" href="/profile">
                        👤 @context.User.Identity?.Name
                    </a>
                    <a href="/logout" title="Çıkış Yap" class="logout-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                            <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                        </svg>
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <hr class="text-white mx-3 mt-3 mb-1" />
                <div class="nav-item px-3">
                    <a class="nav-link" href="/login">Google ile Giriş Yap</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>
