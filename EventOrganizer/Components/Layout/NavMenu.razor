@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-container">
    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle-label">
        <span></span><span></span><span></span>
    </label>

    <nav class="nav-menu">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door-fill nav-icon"></i> Etkinlikler
        </NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link" href="my-events">
                    <i class="bi bi-rocket-takeoff-fill nav-icon"></i> Etkinliklerim
                </NavLink>
                <NavLink class="nav-link" href="create-event">
                    <i class="bi bi-plus-square-fill nav-icon"></i> Etkinlik Oluştur
                </NavLink>
                <NavLink class="nav-link" href="create-template">
                    <i class="bi bi-grid-fill nav-icon"></i> Template Oluştur
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="nav-auth">
        <AuthorizeView>
            <Authorized>
                <div class="nav-user-wrap">
                    <a class="nav-user-info" href="/profile">
                        @{
                            var picture = context.User.FindFirst("picture")?.Value;
                        }
                        @if (!string.IsNullOrEmpty(picture))
                        {
                            <img src="@picture" class="user-avatar user-avatar-photo" alt="" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <div class="user-avatar">@GetInitial(context.User.Identity?.Name)</div>
                        }
                        <span class="user-name">@context.User.Identity?.Name</span>
                    </a>
                    <a href="/logout" class="nav-logout" title="Çıkış Yap">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                            <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                        </svg>
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="nav-link nav-login" href="/login">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" style="margin-right:6px">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                        <path d="M8 9a5 5 0 0 0-4.546 2.916C4.475 13.317 6.115 14 8 14s3.526-.683 4.546-1.084A5 5 0 0 0 8 9z"/>
                    </svg>
                    Google ile Giriş
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private static string GetInitial(string? name)
        => string.IsNullOrEmpty(name) ? "?" : name[0].ToString().ToUpper();
}
